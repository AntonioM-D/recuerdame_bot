# Copy to .env and replace every example value before starting the bot.
BOT_TOKEN=replace_with_token_from_BotFather
ALLOWED_USER_IDS=123456789
ALERT_API_TOKEN=replace_with_a_long_random_secret
DOCKERHUB_IMAGE=valkm/recuerdame_bot:latest

TIMEZONE=Europe/Madrid
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8080
API_BIND_PORT=8787
DB_PATH=/app/data/mibot.db

# Persistent reminders: repeat interval and retry limit.
REMINDER_REPEAT_MINUTES=30
REMINDER_MAX_RETRIES=3

# Container timezone (keep aligned with TIMEZONE).
TZ=Europe/Madrid
